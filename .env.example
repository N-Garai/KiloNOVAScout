# KilonovaScout Environment Variables
# Copy this file to .env and fill in your actual values

# NASA GCN Kafka Credentials (get from https://gcn.nasa.gov/credentials)
GCN_KAFKA_CLIENT_ID=your_client_id_here
GCN_KAFKA_CLIENT_SECRET=your_client_secret_here

# LLM API Keys (Free tiers available)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Telegram Bot (for human-in-the-loop notifications)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Observatory Configuration (Defaults to Palomar Observatory)
OBSERVATORY_NAME=Palomar Observatory
OBSERVATORY_LAT=33.356
OBSERVATORY_LON=-116.865
OBSERVATORY_ALT=1706

# Event classes to watch live (comma-separated: bns, grb, neutrino)
ALERT_CLASSES=bns,grb,neutrino

# LLM Model Selection
PRIMARY_LLM=google/gemini-1.5-flash
FALLBACK_LLM=groq/llama3-70b-8192

# Optional: AWS Bedrock (if using Bedrock AgentCore)
USE_BEDROCK=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Render Deployment (auto-populated)
PORT=8000
PYTHONUNBUFFERED=1