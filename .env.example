# KilonovaScout Environment Variables
# Copy this file to .env and fill in your actual values

# NASA GCN Kafka Credentials (get from https://gcn.nasa.gov/credentials)
GCN_KAFKA_CLIENT_ID=your_client_id_here
GCN_KAFKA_CLIENT_SECRET=your_client_secret_here

# LLM API Keys (Free tiers available)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Outbound alerting (fires on EVERY finished run, completed and failed).
# Point this at any HTTPS endpoint accepting a JSON POST: Discord/Slack
# webhook, PagerDuty Events API, ntfy.sh topic (native title + urgent
# priority are automatic for ntfy targets).
# NOTE: there is no built-in SMS/Telegram sender — TELEGRAM_* style keys
# would be dead config, so they are deliberately absent here.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
# Set true to wake the on-call human ONLY on genuine triggers (skips
# mock/demo runs). Default false = notify on every finished run.
ALERT_LIVE_ONLY=false

# Daily digest mail (opt-in). Summarizes the last 24 h of retained runs with
# report links, sent once per day at DIGEST_HOUR_UTC. Needs an SMTP account
# (e.g. Gmail App Password); a quiet sky still sends, saying so explicitly.
DIGEST_ENABLED=false
DIGEST_HOUR_UTC=6
DIGEST_SMTP_HOST=smtp.gmail.com
DIGEST_SMTP_PORT=465
DIGEST_SMTP_USER=you@gmail.com
DIGEST_SMTP_PASS=your-app-password-here
DIGEST_FROM=KilonovaScout <you@gmail.com>
DIGEST_TO=observer@observatory.org

# Observatory Configuration (Defaults to Palomar Observatory)
OBSERVATORY_NAME=Palomar Observatory
OBSERVATORY_LAT=33.356
OBSERVATORY_LON=-116.865
OBSERVATORY_ALT=1706

# Event classes to watch live (comma-separated: bns, grb, neutrino)
ALERT_CLASSES=bns,grb,neutrino

# GraceDB REST poller: IPv6-free live BNS path (opt-in; polls public
# superevents over plain HTTPS — the only live trigger source that works
# from Render free tier). Off by default; demo/fallback covers the rest.
GRACEDB_POLL=false
GRACEDB_POLL_MINUTES=15

# LLM Model Selection
PRIMARY_LLM=gemini/gemini-2.5-flash
FALLBACK_LLM=groq/openai/gpt-oss-120b

# Render Deployment (auto-populated)
PORT=8000
PYTHONUNBUFFERED=1